<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown when a YouTube trailer could not be handed to the YouTube channel (not installed, or the
  launch did not take): the trailer's title, its watch URL and a QR code of that URL, so it can
  be opened on a phone. Close (OK) or Back dismisses it.
  Fields:
    videoTitle   the trailer's name
    message      why it is shown ("YouTube isn't installed on this Roku." …)
    url          https://www.youtube.com/watch?v=<id>; drawn as text and as the QR code
    dismissed (out, alwaysNotify)
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="YouTubeHandoffDialog" extends="Group">
  <interface>
    <field id="videoTitle" type="string" onChange="layout" />
    <field id="message" type="string" onChange="layout" />
    <field id="url" type="string" onChange="onUrl" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/YouTubeHandoffDialog.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <children>
    <Rectangle id="dim" width="1920" height="1080" color="0x000000C7" />
    <Group id="card" translation="[360, 250]">
      <Poster id="cardBg" uri="pkg:/images/ui/r38.9.png" blendColor="0x1C1D22F7" width="1200" height="580" />
      <Poster id="cardRing" uri="pkg:/images/ui/r38_ring2.9.png" blendColor="0xFFFFFF24" width="1200" height="580" />
      <AuthQrCode id="qr" qrSize="340" padding="20" translation="[60, 60]" />
      <Label id="eyebrow" text="WATCH ON YOUR PHONE" translation="[500, 64]" width="640" color="0xEDEDED9E">
        <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="22" />
      </Label>
      <Label id="titleLabel" translation="[500, 104]" width="640" wrap="true" maxLines="2" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="38" />
      </Label>
      <Label id="messageLabel" translation="[500, 210]" width="640" wrap="true" maxLines="3" lineSpacing="4" color="0xEDEDEDBF">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="26" />
      </Label>
      <Label id="urlLabel" translation="[500, 340]" width="640" wrap="true" maxLines="2" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="26" />
      </Label>
      <PillButton id="closeBtn" text="Close" variant="solid" translation="[500, 440]" scaleOnFocus="1.0" />
    </Group>
  </children>
</component>
