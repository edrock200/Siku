<?xml version="1.0" encoding="utf-8"?>
<!--
  Centered action menu (card long-press / "More Actions"). Dims the screen behind it.
  Fields:
    title     optional title shown above the rows
    actions   array of {id, label, icon?}
    chosen    (out, alwaysNotify) id of the chosen action
    dismissed (out, alwaysNotify) true when closed with Back
  Usage: set `actions` (and `title`), set visible = true, call setFocus(true). The menu hides itself
  after `chosen` or `dismissed`; the host restores focus.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="ShellActionMenu" extends="Group">
  <interface>
    <field id="title" type="string" onChange="rebuild" />
    <field id="actions" type="array" onChange="rebuild" />
    <field id="chosen" type="string" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/ShellActionMenu.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <children>
    <Rectangle id="dim" width="1920" height="1080" color="0x000000A6" />
    <Poster id="shadow" uri="pkg:/images/ui/r32.9.png" blendColor="0x0000008C" />
    <Poster id="bg" uri="pkg:/images/ui/r28.9.png" blendColor="0x1A1C22FA" />
    <Poster id="ring" uri="pkg:/images/ui/r28_ring2.9.png" blendColor="0xFFFFFF26" />
    <Label id="titleLabel" color="0xEDEDEDFF" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="31" />
    </Label>
    <Group id="rowsGroup" />
  </children>
</component>
