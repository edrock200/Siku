<?xml version="1.0" encoding="utf-8"?>
<!--
  Square media card for album / audiobook rails (RowList itemComponentName="AudioCardItem").
  Same content fields and focus idiom as MediaCardItem (scale 1.10, 4 px #EDEDED ring, glow),
  but with a 1:1 image: album covers and audiobook covers are square.
  Reads ContentNode fields set by Content_cardNode: title, subtitle, HDPosterUrl.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="AudioCardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
    <field id="gridHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/AudioCardItem.brs" />
  <children>
    <Group id="card">
      <Poster id="glow" uri="pkg:/images/ui/r20.9.png" blendColor="0xFFFFFF47" opacity="0" />
      <Poster id="placeholder" uri="pkg:/images/ui/r16.9.png" blendColor="0x15171CFF" />
      <Poster id="placeholderIcon" uri="pkg:/images/icons/album.png" blendColor="0xEDEDED40" />
      <MaskGroup id="mask" maskUri="pkg:/images/ui/mask_square.png">
        <Poster id="image" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Poster id="border" uri="pkg:/images/ui/r16_ring4.9.png" blendColor="0xEDEDEDFF" opacity="0" />
    </Group>
    <Label id="title" color="0xEDEDEDC7" horizAlign="left" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="27" />
    </Label>
    <Label id="subtitle" color="0xEDEDEDB3" horizAlign="left" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
    </Label>
  </children>
</component>
