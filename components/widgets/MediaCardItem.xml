<?xml version="1.0" encoding="utf-8"?>
<!--
  Item component for RowList / MarkupGrid / PosterGrid rows of media.
  Reads the ContentNode fields set by Content_cardNode (components/common/Content.brs).
  Styles: poster (2:3), landscape (16:9, Continue Watching / episodes), circle (people),
  square (1:1, audiobooks / albums / audiobook groups).
  A card without artwork (no URL, or the image failed to load) shows the default artwork: the
  art_default_* glow with a type mark (Android TV DefaultArtwork, #530); people keep the plain circle
  and audiobook groups their initials.
  Focus (Silo Android TV #781, as tvOS): a 5% lift by whole px on each side, a 4 px white outline at
  70% inside the card's edge and a black drop shadow (components/common/CardFocus.brs); the caption
  only brightens and stays put. Labels on the art (Explore all, initials, a person's name) are drawn
  at their own size when the lift settles, not resampled (components/common/FocusText.brs).
  The containing list must set drawFocusFeedback="false".
  exploreAll (optional boolean field on the content node): the row's "Explore all" card (no image,
  no caption; HomeSkylineFeed adds it).
  boxSet / cornerLabel (Content.brs): a box set card draws sleeves above the poster, a "BOX SET"
  pill and the film count, and its progress bar is the share of its films watched (a full bar too).
  Card overlays (Silo Android TV TvMediaCard CardOverlays): posters and landscape cards carry the
  badges the profile's ui.card_overlays document picks, and a started series or season poster the
  episodes left in the watched check's place (poster-shaped art only: landscape cards show neither,
  Silo Android #882); two Posters made on first use, between the art and the
  watched check (components/common/CardOverlayCard.brs). Explore all and marked cards carry none.
  markedBadge (optional string field on the content node): the card is outlined at rest and tagged
  with that text in the top-left pill (the movie on screen in a movie page's box set row: "THIS FILM").
  playGlyph (optional boolean field on the content node): a centered play button over the image,
  for the detail page's "Trailers & More" cards.
  cardInsetX / cardInsetY on the content node pad the card inside its cell (MarkupGrid cells clip to
  the grid's bounds, so the first column / row leaves room for the lifted card and its shadow).
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="MediaCardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" onChange="onFocus" />
    <field id="gridHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowListHasFocus" type="boolean" value="true" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/MediaCardItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardOverlayKeys.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardOverlayCard.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardFocus.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/FocusText.brs" />
  <children>
    <Group id="inner">
      <Group id="card">
        <!-- The focused card's drop shadow (black 50%, 24 px of blur, 10 px lower). -->
        <Poster id="glow" uri="pkg:/images/ui/card_shadow.9.png" blendColor="0x00000080" visible="false" />
        <!-- A box set card (boxSet on the content node, Silo Android #646 BoxSetSleeves): two sleeves
             peek above the poster so the card reads as a stack of films. They run on under the poster,
             which covers all but the strip above its top edge. -->
        <Group id="sleeves" visible="false">
          <Poster id="sleeveBack" uri="pkg:/images/ui/r22.9.png" blendColor="0x28282EFF" />
          <Poster id="sleeveFrontEdge" uri="pkg:/images/ui/r22.9.png" blendColor="0x28282EFF" />
          <Poster id="sleeveFront" uri="pkg:/images/ui/r22.9.png" blendColor="0x232328FF" />
        </Group>
        <Poster id="placeholder" uri="pkg:/images/ui/r16.9.png" blendColor="0x15171CFF" />
        <Label id="placeholderText" horizAlign="center" vertAlign="center" wrap="true" maxLines="3" color="0xEDEDED80">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="24" />
        </Label>
        <Label id="initialsText" horizAlign="center" vertAlign="center" maxLines="1" color="0xEDEDEDA6" visible="false">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="72" />
        </Label>
        <MaskGroup id="mask" maskUri="pkg:/images/ui/mask_poster.png">
          <!-- Missing artwork: a faint glow in Siku's colours (scripts/make_default_artwork.py). -->
          <Poster id="defaultArt" loadDisplayMode="scaleToFill" visible="false" />
          <Poster id="image" loadDisplayMode="scaleToZoom" />
          <Poster id="shade" uri="pkg:/images/ui/scrim_bottom.png" opacity="0" />
          <Rectangle id="progressTrack" color="0xFFFFFF33" visible="false" />
          <Rectangle id="progressFill" color="0xEDEDEDFF" visible="false" />
        </MaskGroup>
        <Group id="playGlyph" visible="false">
          <Poster id="playGlyphBg" uri="pkg:/images/ui/circle.png" blendColor="0x0000008C" width="60" height="60" />
          <Poster id="playGlyphIcon" uri="pkg:/images/icons/play.png" blendColor="0xFFFFFFFF" width="36" height="36" translation="[13, 12]" />
        </Group>
        <!-- The type mark centred on the default artwork: film, TV or headphones, 13% white. -->
        <Poster id="defaultMark" blendColor="0xFFFFFF21" visible="false" />
        <!-- The watched check (Silo Android #882, the web's CardWatchStatus): an emerald disc with a
          1 px white 35% ring (drawn opaque: the ring colour over the disc) and a white check. -->
        <Group id="watchedBadge" visible="false">
          <Poster id="watchedRing" uri="pkg:/images/ui/circle.png" blendColor="0x59D3AAFF" />
          <Poster id="watchedBg" uri="pkg:/images/ui/circle.png" blendColor="0x00BC7DFF" />
          <Poster id="watchedIcon" uri="pkg:/images/icons/check.png" blendColor="0xFFFFFFFF" />
        </Group>
        <!-- A box set's "BOX SET" pill (top left) and film count (bottom right), TvMediaCard badge / cornerLabel. -->
        <Group id="boxPill" visible="false">
          <Poster id="boxPillBg" uri="pkg:/images/ui/r16.9.png" blendColor="0x0000008C" height="32" />
          <Poster id="boxPillRing" uri="pkg:/images/ui/r16_ring2.9.png" blendColor="0xFFFFFF26" height="32" />
          <Label id="boxPillLabel" text="BOX SET" height="32" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
          </Label>
        </Group>
        <Group id="cornerTag" visible="false">
          <Poster id="cornerTagBg" uri="pkg:/images/ui/r8.9.png" blendColor="0x00000099" height="32" />
          <Label id="cornerTagLabel" height="32" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="21" />
          </Label>
        </Group>
        <!-- "Explore all" (exploreAll on the content node, Silo Android #688 TvExploreAllCard): the
             last card of a Home or library row, a translucent tile with an arrow and its label. -->
        <Group id="explore" visible="false">
          <Poster id="exploreCircle" uri="pkg:/images/ui/circle.png" blendColor="0xFFFFFF24" width="88" height="88" />
          <Poster id="exploreIcon" uri="pkg:/images/icons/chevron_right.png" blendColor="0xFFFFFFFF" width="56" height="56" translation="[16, 16]" />
          <Label id="exploreLabel" text="Explore all" horizAlign="center" maxLines="1" color="0xEDEDEDD9">
            <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="27" />
          </Label>
        </Group>
        <!-- The focus outline: 4 px of white at 70% (Android's 2 dp), a Poster so it needs no MaskGroup. -->
        <Poster id="border" uri="pkg:/images/ui/r16_ring4.9.png" blendColor="0xFFFFFFB3" visible="false" />
      </Group>
      <Label id="title" color="0xEDEDEDC7" horizAlign="left" maxLines="1">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="27" />
      </Label>
      <Label id="subtitle" color="0xEDEDEDB3" horizAlign="left" maxLines="1">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
      </Label>
    </Group>
  </children>
</component>
