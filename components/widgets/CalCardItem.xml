<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar poster item: a MediaCardItem plus up to three "PREMIERE" / "NEW SEASON" / "FINALE" badges
  (the ContentNode's `badge` field, labels joined with "|") in the poster's top-left corner and the
  air time (`timeTag`, "9:00 PM") in its bottom-right corner.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="CalCardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="forward" />
    <field id="height" type="float" onChange="forward" />
    <field id="focusPercent" type="float" onChange="forward" />
    <field id="itemHasFocus" type="boolean" onChange="forward" />
    <field id="rowHasFocus" type="boolean" onChange="forward" />
    <field id="gridHasFocus" type="boolean" onChange="forward" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/CalCardItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <children>
    <MediaCardItem id="inner" />
    <!-- Up to three badges stacked in the poster's top-left corner (Silo Android TV BadgePill). -->
    <Group id="badges" translation="[12, 12]">
      <Group id="badge0" visible="false">
        <Poster id="badgeBg0" uri="pkg:/images/ui/r8.9.png" blendColor="0x000000B3" height="34" />
        <Poster id="badgeRing0" uri="pkg:/images/ui/r8_ring2.9.png" blendColor="0xFFFFFF4D" height="34" />
        <Label id="badgeLabel0" height="34" vertAlign="center" horizAlign="center" color="0xEDEDEDFF">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
        </Label>
      </Group>
      <Group id="badge1" visible="false">
        <Poster id="badgeBg1" uri="pkg:/images/ui/r8.9.png" blendColor="0x000000B3" height="34" />
        <Poster id="badgeRing1" uri="pkg:/images/ui/r8_ring2.9.png" blendColor="0xFFFFFF4D" height="34" />
        <Label id="badgeLabel1" height="34" vertAlign="center" horizAlign="center" color="0xEDEDEDFF">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
        </Label>
      </Group>
      <Group id="badge2" visible="false">
        <Poster id="badgeBg2" uri="pkg:/images/ui/r8.9.png" blendColor="0x000000B3" height="34" />
        <Poster id="badgeRing2" uri="pkg:/images/ui/r8_ring2.9.png" blendColor="0xFFFFFF4D" height="34" />
        <Label id="badgeLabel2" height="34" vertAlign="center" horizAlign="center" color="0xEDEDEDFF">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
        </Label>
      </Group>
    </Group>
    <!-- The air time in the poster's bottom-right corner (Android TV's air-time capsule). -->
    <Group id="timeTag" visible="false">
      <Poster id="timeBg" uri="pkg:/images/ui/r16.9.png" blendColor="0x0000009E" height="32" />
      <Label id="timeLabel" height="32" vertAlign="center" horizAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
      </Label>
    </Group>
  </children>
</component>
