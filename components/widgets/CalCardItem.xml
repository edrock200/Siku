<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar poster item: a MediaCardItem plus a "PREMIERE" / "NEW SEASON" / "FINALE" badge
  (read from the ContentNode's `badge` field) in the poster's top-left corner.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="CalCardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="forward" />
    <field id="height" type="float" onChange="forward" />
    <field id="focusPercent" type="float" onChange="forward" />
    <field id="itemHasFocus" type="boolean" onChange="forward" />
    <field id="rowHasFocus" type="boolean" onChange="forward" />
    <field id="gridHasFocus" type="boolean" onChange="forward" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/CalCardItem.brs" />
  <children>
    <MediaCardItem id="inner" />
    <Group id="badge" visible="false" translation="[12, 12]">
      <Poster id="badgeBg" uri="pkg:/images/ui/r8.9.png" blendColor="0x000000B3" height="34" />
      <Poster id="badgeRing" uri="pkg:/images/ui/r8_ring2.9.png" blendColor="0xFFFFFF4D" height="34" />
      <Label id="badgeLabel" height="34" vertAlign="center" horizAlign="center" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
      </Label>
    </Group>
  </children>
</component>
