<?xml version="1.0" encoding="utf-8"?>
<!--
  Episode rail card (design-spec §4.3 Episodes): a 16:9 still with a 10 px progress bar and a watched
  check, then the caption "S01E02 · Title" over "Feb 18, 2026  ·  52m" (an optional eyebrow above
  it) and a 3-line synopsis. Focus: the card look of every card (components/common/CardFocus.brs,
  Silo Android TV #781): a 5% lift, a 4 px white outline at 70% and a black drop shadow; the title
  brightens. The current episode, the one Play acts on (itemContent.isCurrent), keeps the outline
  and the bright title without the lift while focus is elsewhere (tvOS's isCurrent).
  cardInsetY on the content node: headroom above the still inside the cell (a real Roku clips items
  to their cell), so the lifted still and its shadow are not cut.
  Expected ContentNode fields: title, HDPosterUrl, progress, watched, eyebrow, meta, synopsis, isCurrent,
  Card overlays (Silo Android TV TvEpisodeCard CardOverlays, Wide variant): the profile's badges
  over the still, under the watched check (components/common/CardOverlayCard.brs).
  aiTranslated (the synopsis is machine-translated: a small translate glyph at the end of the meta line,
  Android TV's compact "Translated by AI" marker).
  aiTranslating (the shown season's auto translation job is filling this description, Silo Android
  #822: passive "Translating description…" above the synopsis, which then keeps two lines; no glyph).
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="DetailEpisodeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowListHasFocus" type="boolean" value="true" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/DetailEpisodeItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardFocus.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardOverlayKeys.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/CardOverlayCard.brs" />
  <children>
    <Group id="card">
      <Poster id="shadow" uri="pkg:/images/ui/card_shadow.9.png" blendColor="0x00000080" visible="false" />
      <Poster id="placeholder" uri="pkg:/images/ui/r16.9.png" blendColor="0x15171CFF" />
      <MaskGroup id="mask" maskUri="pkg:/images/ui/mask_landscape.png">
        <!-- Default artwork under the still: shows when there is no still, it fails to load, or
             spoiler protection hides it (the glow and the TV mark, as MediaCardItem). -->
        <Poster id="defaultArt" uri="pkg:/images/ui/art_default_landscape.png" loadDisplayMode="scaleToFill" />
        <Poster id="placeholderIcon" uri="pkg:/images/icons/tv.png" blendColor="0xFFFFFF21" />
        <Poster id="image" loadDisplayMode="scaleToZoom" />
        <Rectangle id="progressTrack" color="0xFFFFFF33" visible="false" />
        <Rectangle id="progressFill" color="0xEDEDEDFF" visible="false" />
      </MaskGroup>
      <Group id="watchedBadge" visible="false">
        <Poster id="watchedBg" uri="pkg:/images/ui/circle.png" blendColor="0xEDEDEDFF" width="44" height="44" />
        <Poster id="watchedIcon" uri="pkg:/images/icons/check.png" blendColor="0x000000FF" width="30" height="30" translation="[7, 7]" />
      </Group>
      <!-- The focus outline, also the current episode's: 4 px of white at 70%. -->
      <Poster id="focusRing" uri="pkg:/images/ui/r16_ring4.9.png" blendColor="0xFFFFFFB3" visible="false" />
    </Group>
    <Label id="eyebrow" color="0xEDEDED9E" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="19" />
    </Label>
    <Label id="title" color="0xEDEDEDC7" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="31" />
    </Label>
    <Label id="meta" color="0xEDEDEDB3" maxLines="1">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
    </Label>
    <Poster id="aiIcon" uri="pkg:/images/icons/language.png" width="24" height="24" blendColor="0xFFFFFF99" visible="false" />
    <Label id="translating" text="Translating description…" color="0xFFFFFF99" maxLines="1" height="30" vertAlign="center" visible="false">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="22" />
    </Label>
    <Label id="synopsis" color="0xEDEDED9E" wrap="true" maxLines="3" lineSpacing="4">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="27" />
    </Label>
  </children>
</component>
