<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen PIN prompt (Android TvPinEntryDialog): the profile's avatar and name, four
  dots, a status line ("Enter your PIN" / "Checking…" / the error), a round 3x4 keypad
  (1–9, 0, backspace) and "Cancel". The fourth digit submits. Focus starts on "5".
  Give it focus with setFocus(true) after adding it; it handles all keys itself.
  Fields:
    profile     the profile being unlocked
    error       error text; setting it clears the entered digits and turns the dots red
    verifying   true while the PIN is checked: shows "Checking…" and ignores digits
    pinEntered  (out, alwaysNotify) the four-digit PIN
    dismissed   (out, alwaysNotify) Cancel or Back
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="AuthPinDialog" extends="Group">
  <interface>
    <field id="profile" type="assocarray" onChange="onProfile" />
    <field id="error" type="string" onChange="onError" />
    <field id="verifying" type="boolean" value="false" onChange="renderStatus" />
    <field id="pinEntered" type="string" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/AuthPinDialog.brs" />
  <children>
    <Poster uri="pkg:/images/marquee_profiles.jpg" width="1920" height="1080" />
    <Rectangle width="1920" height="1080" color="0x00000059" />
    <AuthAvatar id="avatar" size="160" showBadges="false" translation="[880, 84]" />
    <Label id="name" width="1920" translation="[0, 266]" horizAlign="center" color="0xEDEDEDFF">
      <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="33" />
    </Label>
    <Group id="dots" translation="[0, 340]" />
    <Label id="status" width="1920" translation="[0, 384]" horizAlign="center">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
    </Label>
    <Group id="keys" translation="[0, 448]" />
    <PillButton id="cancel" text="Cancel" variant="plain" height="61" fontSize="21" padX="28" />
  </children>
</component>
