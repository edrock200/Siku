<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row: label left, value + chevron right. Focused rows invert to #EDEDED.
     Also used for the rail (with `icon` and `description`).
     SPDX-License-Identifier: AGPL-3.0-or-later -->
<component name="SettingsRow" extends="Group">
  <interface>
    <field id="label" type="string" onChange="layout" />
    <field id="value" type="string" onChange="layout" />
    <field id="description" type="string" onChange="layout" />
    <field id="iconUri" type="string" onChange="layout" />
    <field id="rowWidth" type="integer" value="1080" onChange="layout" />
    <field id="rowHeight" type="integer" value="76" onChange="layout" />
    <!-- Label column width; 0 = half the row (the value takes the other half). -->
    <field id="labelWidth" type="integer" value="0" onChange="layout" />
    <field id="showChevron" type="boolean" value="true" onChange="layout" />
    <field id="highlighted" type="boolean" value="false" onChange="applyState" />
    <field id="focusedState" type="boolean" value="false" onChange="applyState" />
    <field id="destructive" type="boolean" value="false" onChange="applyState" />
    <!-- Screen reader position when the row's siblings are not the whole list (a windowed picker);
         a11yCount 0 = count the visible SettingsRow siblings. -->
    <field id="a11yIndex" type="integer" value="0" />
    <field id="a11yCount" type="integer" value="0" />
    <!-- Set to say the focused row again (focus came back from a picker). -->
    <field id="a11yAnnounce" type="boolean" alwaysNotify="true" onChange="announce" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/SettingsRow.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/A11y.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/ui/r14.9.png" />
    <Poster id="ring" uri="pkg:/images/ui/r14_ring2.9.png" blendColor="0xFFFFFF1A" visible="false" />
    <Poster id="icon" width="40" height="40" visible="false" />
    <Label id="labelText" vertAlign="center">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="26" />
    </Label>
    <Label id="descText" vertAlign="center" visible="false" wrap="true" maxLines="2">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="22" />
    </Label>
    <Label id="valueText" vertAlign="center" horizAlign="right">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="25" />
    </Label>
    <Poster id="chevron" uri="pkg:/images/icons/chevron_right.png" width="36" height="36" />
  </children>
</component>
