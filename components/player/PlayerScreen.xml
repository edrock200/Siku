<?xml version="1.0" encoding="utf-8"?>
<!--
  Video player (docs/design-spec.md §4.10, docs/api-spec.md §8).
  params: { itemId, fileId?, startPosition? (seconds; 0 = start over; omitted = server resume),
            title?, audioTrackId? / audioTrackIndex?, subtitleTrackId? / subtitleTrackIndex? (-1 = off),
            shuffleId? (+ shuffle?: the Shuffle the start returned) — a running shuffle: every pick
            plays from the beginning, Up Next announces the server's random pick ("UP NEXT AT RANDOM")
            with Pick Another / Stop shuffling, and no sequential next episode is offered,
            itemType?/source? "extra" (a detail page's local trailer or featurette: plays from
            startPosition 0, offers no next episode, Up Next or On Deck), durationSeconds? (used when
            the watch detail has none) }
  Up Next (silo-android #541): the next episode's still (else the first On Deck item's art) fills
            the screen under a scrim (no blur on Roku), the video shrinks into a pane, and an On Deck
            row of other items in progress (home continue-watching sections) runs along the bottom.
  Pipeline: GET /watch/{id} → GET /playback/capabilities (cached on m.global.playbackCaps)
            → POST /playback/start → Video node → progress every 10 s → DELETE /playback/{session}.
  The Video node never takes focus (enableUI=false); keys go to focusSink or our own controls so
  this screen's onKeyEvent sees them.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="PlayerScreen" extends="BaseScreen">
  <interface>
    <!-- A SiloCast control from Silo's phone app (RemoteControl.onControl; PlayerRemote.brs). -->
    <field id="remoteCommand" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/player/PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlaybackCaps.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/SubtitleSuite.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/BufferingQuality.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerBuffering.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/Trickplay.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerTrickplay.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerHoldSeek.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerSeekReanchor.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Shuffle.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Tracks.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/SeriesChoice.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerRemote.brs" />
  <script type="text/brightscript" uri="pkg:/components/remote/RemotePrefs.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
    <!-- Up Next artwork. Drawn before the Video node so the video pane shows through it. -->
    <Group id="unBackdropGroup" visible="false">
      <Poster id="unBackdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
      <Rectangle width="1920" height="1080" color="0x00000099" />
      <Poster uri="pkg:/images/ui/scrim_bottom.png" width="1920" height="500" translation="[0, 580]" opacity="0.9" />
    </Group>
    <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" notificationInterval="1" />
    <Poster id="videoFrame" uri="pkg:/images/ui/r16_ring2.9.png" blendColor="0xFFFFFF29" visible="false" />
    <Group id="focusSink" focusable="true" />

    <Group id="bufferingGroup" visible="false">
      <LoadingSpinner id="bufferSpinner" size="96" translation="[912, 472]" />
      <Label id="bufferLabel" text="Buffering" width="1920" translation="[0, 590]" horizAlign="center" color="0xEDEDEDBF">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="27" />
      </Label>
    </Group>

    <Group id="feedbackGroup" visible="false">
      <Poster uri="pkg:/images/ui/r42.9.png" blendColor="0x000000A6" width="200" height="84" translation="[860, 498]" />
      <Label id="feedbackLabel" width="200" height="84" translation="[860, 498]" horizAlign="center" vertAlign="center" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="30" />
      </Label>
    </Group>

    <Group id="controls" visible="false">
      <Poster id="scrim" uri="pkg:/images/ui/scrim_bottom_player.png" width="1920" height="480" translation="[0, 600]" />
      <Label id="titleLabel" translation="[160, 630]" width="1200" maxLines="1" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="34" />
      </Label>
      <Label id="epTag" translation="[160, 676]" width="1200" maxLines="1" color="0xEDEDED9E">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="26" />
      </Label>
      <PlayerScrubber id="scrubber" translation="[160, 796]" width="1600" />
      <Group id="transport" translation="[160, 912]">
        <PlayerTransportButton id="skipBackBtn" iconUri="pkg:/images/icons/rewind.png" translation="[0, 0]" />
        <PlayerTransportButton id="playPauseBtn" iconUri="pkg:/images/icons/pause.png" translation="[98, 0]" />
        <PlayerTransportButton id="skipFwdBtn" iconUri="pkg:/images/icons/forward.png" translation="[196, 0]" />
        <PlayerTransportButton id="upNextBtn" iconUri="pkg:/images/icons/skip_next.png" visible="false" />
        <PlayerTransportButton id="subtitlesBtn" iconUri="pkg:/images/icons/subtitles.png" />
        <PlayerTransportButton id="tuneBtn" iconUri="pkg:/images/icons/tune.png" />
        <PlayerTransportButton id="closeBtn" iconUri="pkg:/images/icons/close.png" />
      </Group>
    </Group>

    <!-- Hold-to-seek with the controls hidden (PlayerHoldSeek.brs): rate chip, bar and hint at
         the top centre; the preview frame (tpView in "frame" mode) sits above the chip. -->
    <Group id="holdSeek" visible="false">
      <Group id="hsChip">
        <Poster id="hsChipBg" uri="pkg:/images/ui/r32.9.png" blendColor="0x0000006B" height="70" />
        <Label id="hsRate" height="70" vertAlign="center" color="0xFFFFFFFF">
          <Font role="font" uri="pkg:/fonts/Inter-black.otf" size="38" />
        </Label>
        <Label id="hsTime" height="70" vertAlign="center" color="0xFFFFFFBF">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="24" />
        </Label>
      </Group>
      <Rectangle id="hsTrack" width="520" height="4" color="0xFFFFFF38" />
      <Rectangle id="hsFill" width="0" height="4" color="0xFFFFFFFF" />
      <Label id="hsHint" width="1920" horizAlign="center" color="0xFFFFFF8C" text="&#8592; &#8594; speed  &#183;  OK play  &#183;  Back cancel">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="24" />
      </Label>
    </Group>

    <!-- Seek-bar preview (PlayerTrickplay.brs): the server's thumbnail cut from its sprite sheet by
         clipping (tpClip) a sheet Poster; a card over the scrubber's puck, or the hold-seek frame. -->
    <Group id="tpView" visible="false">
      <Poster id="tpBg" uri="pkg:/images/ui/r20.9.png" blendColor="0x131417F4" />
      <Poster id="tpSlot" uri="pkg:/images/ui/r20.9.png" blendColor="0x0000006B" visible="false" />
      <MaskGroup id="tpMask" maskUri="pkg:/images/ui/mask_landscape.png" maskSize="[320, 180]" visible="false">
        <Group id="tpClip" clippingRect="[0, 0, 320, 180]" />
      </MaskGroup>
      <Poster id="tpRing" uri="pkg:/images/ui/r20_ring2.9.png" blendColor="0xFFFFFF1A" />
      <Label id="tpTime" horizAlign="center" vertAlign="center" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="24" />
      </Label>
    </Group>

    <Group id="skipGroup" visible="false">
      <Label id="skippedCaption" text="Intro skipped" color="0xEDEDEDBF" horizAlign="right" width="400" visible="false">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="24" />
      </Label>
      <PillButton id="skipBtn" text="Skip Intro" variant="glass" height="72" padX="48" fontSize="28" scaleOnFocus="1.0" />
    </Group>

    <!-- Buffering quality pill (PlayerBuffering.brs): "Playback keeps buffering" with Lower / Keep
         quality, or "Quality lowered to stop buffering" with Restore quality; 15 s countdown. -->
    <Group id="bufqPill" visible="false">
      <Poster id="bufqBg" uri="pkg:/images/ui/r28.9.png" blendColor="0x0A0A0AEB" width="760" height="176" />
      <Rectangle id="bufqFill" color="0xEDEDED33" width="760" height="4" translation="[0, 172]" />
      <Label id="bufqTitle" translation="[32, 24]" width="600" height="44" vertAlign="center" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="28" />
      </Label>
      <Label id="bufqCount" width="80" height="44" horizAlign="right" vertAlign="center" color="0xEDEDED9E">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="26" />
      </Label>
      <PillButton id="bufqPrimary" text="Lower quality" variant="glass" height="64" padX="36" fontSize="25" scaleOnFocus="1.0" translation="[32, 84]" />
      <PillButton id="bufqSecondary" text="Keep quality" variant="glass" height="64" padX="36" fontSize="25" scaleOnFocus="1.0" />
    </Group>

    <Group id="hud" visible="false">
      <Group id="hudTabs" translation="[240, 100]" />
      <Poster id="hudBg" uri="pkg:/images/ui/r32.9.png" blendColor="0x0A0A0AF5" width="1440" height="400" translation="[240, 196]" />
      <Poster id="hudRing" uri="pkg:/images/ui/r32_ring2.9.png" blendColor="0xFFFFFF24" width="1440" height="400" translation="[240, 196]" />
      <Group id="hudRows" translation="[280, 236]" />
    </Group>

    <Group id="upNext" visible="false">
      <Group id="upNextPanel" translation="[1136, 240]">
        <!-- Shuffle only: "Shuffling <scope>" chip above the eyebrow. -->
        <Group id="unScope" translation="[0, -64]" visible="false">
          <Poster id="unScopeBg" uri="pkg:/images/ui/r20.9.png" blendColor="0xFFFFFF1A" height="40" width="200" />
          <Poster id="unScopeIcon" uri="pkg:/images/icons/shuffle.png" width="24" height="24" translation="[16, 8]" blendColor="0xEDEDEDBF" />
          <Label id="unScopeLabel" translation="[48, 0]" height="40" vertAlign="center" color="0xEDEDEDBF" maxLines="1">
            <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="22" />
          </Label>
        </Group>
        <Label id="unEyebrow" text="UP NEXT" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-black.otf" size="24" />
        </Label>
        <Label id="unSeries" translation="[0, 44]" width="620" maxLines="1" color="0xEDEDEDBF">
          <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="28" />
        </Label>
        <Label id="unEpisode" translation="[0, 90]" width="620" wrap="true" maxLines="2" color="0xEDEDEDFF">
          <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="44" />
        </Label>
        <Label id="unMeta" translation="[0, 206]" width="620" maxLines="1" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="24" />
        </Label>
        <Label id="unOverview" translation="[0, 246]" width="620" wrap="true" maxLines="4" lineSpacing="4" color="0xEDEDEDBF">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="26" />
        </Label>
        <!-- Buttons are stacked by layoutUpNextButtons(); hidden ones are skipped. -->
        <PillButton id="unPlayBtn" text="Play Now" variant="solid" fixedWidth="440" translation="[0, 420]" scaleOnFocus="1.0" />
        <PillButton id="unPickBtn" text="Pick Another" fixedWidth="440" translation="[0, 514]" scaleOnFocus="1.0" visible="false" />
        <PillButton id="unKeepBtn" text="Keep Watching" fixedWidth="520" translation="[0, 514]" scaleOnFocus="1.0" />
        <PillButton id="unBackBtn" text="Back" fixedWidth="320" translation="[0, 608]" scaleOnFocus="1.0" />
        <PillButton id="unStopBtn" text="Stop shuffling" iconUri="pkg:/images/icons/shuffle.png" fixedWidth="440" translation="[0, 702]" scaleOnFocus="1.0" visible="false" />
      </Group>
      <!-- On Deck: other items in progress. Cards sit 32 px down in their cells (pitfall 12). -->
      <Group id="onDeck" translation="[160, 736]" visible="false">
        <Label id="onDeckLabel" text="On Deck" color="0xEDEDEDDB">
          <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="29" />
        </Label>
        <RowList id="onDeckRow" translation="[0, 12]" itemComponentName="MediaCardItem"
                 itemSize="[1760, 300]" rowItemSize="[[272, 300]]" rowItemSpacing="[[32, 0]]" numRows="1"
                 drawFocusFeedback="false" rowFocusAnimationStyle="fixedFocus" showRowLabel="[false]" />
      </Group>
    </Group>

    <Group id="errorGroup" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000FF" />
      <Poster uri="pkg:/images/icons/error.png" width="80" height="80" translation="[920, 380]" blendColor="0xEDEDED9E" />
      <Label id="errorTitle" text="Something went wrong" width="1920" translation="[0, 480]" horizAlign="center" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="38" />
      </Label>
      <Label id="errorLabel" width="1200" translation="[360, 540]" horizAlign="center" wrap="true" maxLines="3" color="0xEDEDEDBF">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="27" />
      </Label>
      <PillButton id="retryBtn" text="Try again" variant="solid" translation="[770, 680]" />
      <PillButton id="errorCloseBtn" text="Close" translation="[990, 680]" />
    </Group>

    <DetailMoreMenu id="picker" visible="false" />
    <!-- Search subtitles / Translate with AI / Subtitle Delay (SubtitleSuite.brs). -->
    <SubtitleDialog id="subsDialog" visible="false" />

    <Timer id="progressTimer" duration="10" repeat="true" />
    <Timer id="hideTimer" duration="5" />
    <Timer id="feedbackTimer" duration="1.2" />
    <Timer id="countdownTimer" duration="1" repeat="true" />
    <Timer id="holdTimer" duration="0.25" repeat="true" />
    <Timer id="refreshTimeout" duration="12" />
    <Timer id="stopTimeout" duration="2.5" />
    <Timer id="captionTimer" duration="4" />
    <Timer id="subsSyncTimer" duration="3" repeat="true" />
    <Timer id="subsAiTimer" duration="2" repeat="true" />
    <!-- How long a playing stream may take to list the plan's HLS subtitle rendition. -->
    <Timer id="renditionTimer" duration="8" />
    <!-- Drives the buffering-quality controller's timers and the pill countdown. -->
    <Timer id="bufqTimer" duration="0.25" repeat="true" />
    <!-- Seek previews: how long the previous thumbnail may stand in for the next one. -->
    <Timer id="tpStaleTimer" duration="1" />
    <!-- Hold-to-seek: a press held this long starts a session; the preview moves every 0.1 s and
         the rate climbs every 1.2 s. -->
    <Timer id="hsPressTimer" duration="0.3" />
    <Timer id="hsTickTimer" duration="0.1" repeat="true" />
    <Timer id="hsRampTimer" duration="1.2" repeat="true" />
  </children>
</component>
