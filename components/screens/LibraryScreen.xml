  (e.g. "See all" of a section, a person's filmography, a collection). Same params as LibraryPage.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="LibraryScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
