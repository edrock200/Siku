<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign-in (Android TvLoginScreen). Two states on one screen:
    code      device-code sign-in (default): server card, "Sign in to <server>", how-to copy and an
              action row; the right card shows the QR of verification_uri_complete, the user code
              as tiles, <host>/activate and a live status line. Implements the api-spec §2.7 flow
              (capability, start, poll with interval/poll_after, backoff, renew, cancel).
    password  "Sign in with a password": Username / Password fields (Roku keyboard), Sign in,
              "Use your phone instead", "Change server".
  Back in password mode returns to the code (unless the server only supports passwords).
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="LoginScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/screens/LoginScreen.brs" />
  <children>
    <AuthMarqueeChrome id="chrome" backdropUri="pkg:/images/marquee_bg.jpg" />

    <Group id="copy" translation="[90, 0]">
      <!-- Server card: mark, name, address, SECURE / HTTP pill. -->
      <Group id="serverCard">
        <Poster id="scBg" uri="pkg:/images/ui/r30.9.png" height="128" blendColor="0xFFFFFF12" />
        <Poster id="scRing" uri="pkg:/images/ui/r30_ring2.9.png" height="128" blendColor="0xFFFFFF24" />
        <Group id="scMark" translation="[24, 24]">
          <Poster id="scMarkBg" uri="pkg:/images/ui/r20.9.png" width="80" height="80" blendColor="0xA8521DFF" />
          <Label id="scMarkInitial" width="80" height="80" horizAlign="center" vertAlign="center" color="0xFFF6EAFF">
            <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="43" />
          </Label>
          <Poster id="scMarkImage" width="80" height="80" loadDisplayMode="scaleToFit" visible="false" />
          <Poster id="scMarkRing" uri="pkg:/images/ui/r20_ring2.9.png" width="80" height="80" blendColor="0xFFFFFF2E" />
        </Group>
        <Label id="scName" translation="[126, 26]" height="40" color="0xEDEDEDFF" maxLines="1">
          <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="29" />
        </Label>
        <Label id="scHost" translation="[126, 68]" height="34" color="0xEDEDED66" maxLines="1">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
        <Group id="scPill">
          <Poster id="scPillBg" uri="pkg:/images/ui/r16.9.png" height="38" />
          <Poster id="scPillRing" uri="pkg:/images/ui/r16_ring2.9.png" height="38" />
          <Label id="scPillLabel" height="38" translation="[16, 0]" vertAlign="center">
            <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="16" />
          </Label>
        </Group>
      </Group>

      <!-- Code state -->
      <Group id="codeCopy">
        <Label id="codeHeadline" width="900" wrap="true" maxLines="3" color="0xEDEDEDFF">
          <Font role="font" uri="pkg:/fonts/Inter-black.otf" size="76" />
        </Label>
        <Label id="codeBody" width="900" wrap="true" lineSpacing="8" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
        <Group id="codeActions">
          <PillButton id="actionButton" variant="glass" iconUri="pkg:/images/icons/refresh.png" visible="false" />
          <PillButton id="passwordButton" text="Sign in with a password" variant="glass" iconUri="pkg:/images/icons/key.png" />
          <PillButton id="changeServerButton" text="Change server" variant="plain" />
        </Group>
      </Group>

      <!-- Password state -->
      <Group id="passwordCopy" visible="false">
        <Label id="pwHeadline" width="900" wrap="true" maxLines="3" color="0xEDEDEDFF" text="Sign in with&#10;a password">
          <Font role="font" uri="pkg:/fonts/Inter-black.otf" size="76" />
        </Label>
        <Label id="pwBody" width="900" wrap="true" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
        <AuthTextField id="usernameField" fieldWidth="760" placeholder="Username" iconUri="pkg:/images/icons/person.png" />
        <AuthTextField id="passwordField" fieldWidth="668" placeholder="Password" iconUri="pkg:/images/icons/lock.png" secure="true" />
        <PillButton id="revealButton" variant="glass" iconUri="pkg:/images/icons/visibility.png" padX="0" height="84" minWidth="84" />
        <Label id="pwError" width="760" wrap="true" color="0xFF6961FF" visible="false">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
        <Group id="pwActions">
          <PillButton id="signInButton" text="Sign in" variant="glass" />
          <PillButton id="usePhoneButton" text="Use your phone instead" variant="plain" />
          <PillButton id="pwChangeServerButton" text="Change server" variant="plain" />
        </Group>
      </Group>
    </Group>

    <!-- Right glass card -->
    <Group id="card" translation="[1190, 0]">
      <Poster id="cardBg" uri="pkg:/images/ui/r40.9.png" width="640" blendColor="0x1F1F1FB8" />
      <Poster id="cardRing" uri="pkg:/images/ui/r40_ring2.9.png" width="640" blendColor="0xFFFFFF24" />

      <Group id="codeCard">
        <AuthQrCode id="qr" qrSize="340" padding="20" translation="[130, 52]" />
        <LoadingSpinner id="qrSpinner" size="56" color="0x00000080" translation="[292, 214]" visible="false" />
        <Group id="symbol" visible="false" translation="[264, 52]">
          <Poster id="symbolBg" uri="pkg:/images/ui/circle.png" width="112" height="112" blendColor="0xFFFFFF14" />
          <Poster id="symbolRing" uri="pkg:/images/ui/circle_ring.png" width="112" height="112" blendColor="0xFFFFFF24" />
          <Poster id="symbolIcon" width="52" height="52" translation="[30, 30]" />
        </Group>
        <Group id="tiles" />
        <Label id="activateLabel" width="536" translation="[52, 0]" horizAlign="center" wrap="true" maxLines="2" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
        <Group id="statusRow">
          <LoadingSpinner id="statusSpinner" size="26" color="0xEDEDED9E" visible="false" />
          <Label id="statusLabel" height="34" vertAlign="center">
            <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
          </Label>
        </Group>
      </Group>

      <Group id="phoneCard" visible="false">
        <Poster uri="pkg:/images/ui/circle.png" width="112" height="112" translation="[264, 52]" blendColor="0xFFFFFF14" />
        <Poster uri="pkg:/images/ui/circle_ring.png" width="112" height="112" translation="[264, 52]" blendColor="0xFFFFFF24" />
        <Poster id="phoneIcon" uri="pkg:/images/icons/phone.png" width="52" height="52" translation="[294, 82]" blendColor="0xEDEDEDFF" />
        <Label id="phoneTitle" width="536" translation="[52, 198]" horizAlign="center" color="0xEDEDEDFF" text="Easier with a phone">
          <Font role="font" uri="pkg:/fonts/Inter-bold.otf" size="34" />
        </Label>
        <Label id="phoneBody" width="536" translation="[52, 256]" horizAlign="center" wrap="true" lineSpacing="6" color="0xEDEDED9E">
          <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
        </Label>
      </Group>
    </Group>

    <Timer id="pollTimer" repeat="false" />
    <Timer id="routeTimer" repeat="false" duration="0.9" />
  </children>
</component>
