<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (Android TV TvSettingsScreen, docs/design-spec.md §4.9): a 490 px rail of categories
     on the left (account row, General / Playback / Subtitles / Server, Sign Out, version) and a
     pane of grouped rows on the right. Most values are server-synced per profile through the
     settings cascade (components/common/Settings.brs); the rest live in m.global.prefs.
     Overlays: the option picker / confirm card, and the full-screen Home Sections editor
     (SettingsHomeSections.brs).
     SPDX-License-Identifier: AGPL-3.0-or-later -->
<component name="SettingsScreen" extends="BaseScreen">
  <interface>
    <!-- Set by Settings_notify when a load this screen started lands (Settings.brs). -->
    <field id="settingsLoaded" type="boolean" alwaysNotify="true" onChange="onSettingsChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/settings/SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/settings/SettingsHomeSections.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Label id="title" text="Settings" translation="[100, 80]" color="0xEDEDEDFF" />

    <!-- Account row (OK switches profile) -->
    <Group id="account" translation="[88, 146]">
      <Poster id="accountBg" uri="pkg:/images/ui/r14.9.png" width="490" height="84" blendColor="0xEDEDEDFF" visible="false" />
      <MaskGroup id="avatarMask" maskUri="pkg:/images/ui/mask_circle.png" maskSize="[64, 64]" translation="[24, 10]">
        <Poster id="avatarBg" uri="pkg:/images/ui/circle.png" width="64" height="64" blendColor="0xFFFFFF2E" />
        <Poster id="avatar" width="64" height="64" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="avatarInitials" width="64" height="64" translation="[24, 10]" horizAlign="center" vertAlign="center" color="0xEDEDEDFF" />
      <Label id="accountName" translation="[108, 14]" width="320" color="0xEDEDEDFF" />
      <Label id="accountSub" translation="[108, 48]" width="320" color="0xEDEDED9E" />
      <Poster id="accountChevron" uri="pkg:/images/icons/chevron_right.png" width="32" height="32" translation="[434, 26]" blendColor="0xEDEDED80" />
    </Group>

    <Group id="rail" translation="[88, 250]" />
    <SettingsRow id="signOutRow" translation="[88, 892]" />
    <Label id="version" translation="[112, 968]" color="0xEDEDED80" />

    <!-- Right pane: header + scrolling groups, clipped to its column -->
    <Group id="paneClip" translation="[630, 80]" clippingRect="[0, 0, 1180, 940]">
      <Group id="pane" />
    </Group>
    <Group id="status" translation="[630, 80]" visible="false">
      <LoadingSpinner id="spinner" size="44" translation="[0, 0]" />
      <Label id="statusLabel" translation="[60, 6]" width="1000" color="0xEDEDED9E" />
    </Group>

    <!-- Option picker / confirm card -->
    <Group id="picker" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000E0" />
      <Poster id="pickerBg" uri="pkg:/images/ui/r22.9.png" blendColor="0x15171CFF" />
      <Poster id="pickerRing" uri="pkg:/images/ui/r22_ring2.9.png" blendColor="0xFFFFFF17" />
      <Label id="pickerTitle" color="0xEDEDEDFF" />
      <Label id="pickerSub" color="0xEDEDED99" />
      <Label id="pickerMessage" color="0xEDEDEDBF" wrap="true" visible="false" />
      <Label id="pickerHint" text="Back to close" color="0xEDEDED99" horizAlign="right" />
      <Rectangle id="pickerDivider" height="1" color="0xFFFFFF14" />
      <Group id="pickerRows" />
    </Group>

    <!-- Home Sections editor (TvHomeSectionsEditor) -->
    <Group id="hsEditor" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000FF" />
      <Label id="hsTitle" text="Home Sections" translation="[400, 64]" color="0xEDEDEDFF" />
      <Label id="hsEyebrow" text="HOME SECTIONS" translation="[400, 118]" color="0xEDEDED80" />
      <Group id="hsHeader" translation="[400, 160]" />
      <Group id="hsClip" translation="[400, 272]" clippingRect="[0, 0, 1140, 700]">
        <Group id="hsRows" />
      </Group>
      <Label id="hsMessage" translation="[400, 300]" width="1120" color="0xEDEDED9E" wrap="true" visible="false" />
      <Label id="hsFooter" translation="[400, 990]" width="1120" color="0xEDEDED9E" />
    </Group>
  </children>
</component>
