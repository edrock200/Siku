<?xml version="1.0" encoding="utf-8"?>
<!--
  Search (design-spec §4.5): big field at the top (OK opens the keyboard), filter chips
  All · Movies · Series (· Audiobooks), a People row, a poster grid and, when the server enables
  requests, an "Available to request" row. params: { query? }
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="SearchScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Requests.brs" />
  <children>
    <Group id="field" translation="[88, 164]">
      <Poster id="fieldBg" uri="pkg:/images/ui/r28.9.png" width="1040" height="104" blendColor="0xFFFFFF0E" />
      <Poster id="fieldRing" uri="pkg:/images/ui/r28_ring2.9.png" width="1040" height="104" blendColor="0xFFFFFF1F" />
      <Poster id="fieldIcon" uri="pkg:/images/icons/search.png" width="40" height="40" translation="[36, 32]" blendColor="0xEDEDED9E" />
      <Label id="fieldText" translation="[96, 0]" width="912" height="104" vertAlign="center" color="0xEDEDED9E" maxLines="1">
        <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="29" />
      </Label>
    </Group>
    <Group id="chips" translation="[88, 292]" />
    <Label id="statusLine" translation="[88, 372]" width="1000" color="0xEDEDED9E">
      <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="24" />
    </Label>
    <RowList id="people" translation="[68, 412]" itemComponentName="MediaCardItem"
             drawFocusFeedback="false" rowFocusAnimationStyle="fixedFocus"
             itemSize="[1852, 310]" numRows="1" focusXOffset="[20]" rowItemSize="[[200, 310]]" rowItemSpacing="[[44, 0]]"
             showRowLabel="[true]" rowLabelOffset="[[20, 0]]" rowLabelColor="0xEDEDEDFF" visible="false">
      <Font role="rowLabelFont" uri="pkg:/fonts/Inter-semibold.otf" size="31" />
    </RowList>
    <!-- Cells carry a 14 px horizontal and 30 px vertical inset (Content_grid insetX/insetY); the card
         pitch (264 + 28, 396 + 90 + 60) is unchanged and the grid starts that much left of / above. -->
    <MarkupGrid id="grid" translation="[60, 390]" itemComponentName="MediaCardItem" numColumns="6" numRows="2"
                itemSize="[292, 546]" itemSpacing="[0, 0]" drawFocusFeedback="false"
                vertFocusAnimationStyle="floatingFocus" visible="false" />
    <!-- "Available to request" (requests enabled, query of 2+ characters): TMDB titles from
         GET /api/v2/requests/search, below the results; it moves up to the results area while focused. -->
    <Group id="reqSection" visible="false">
      <Label id="reqHeader" text="Available to request" translation="[88, 0]" color="0xEDEDEDFF">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="31" />
      </Label>
      <Label id="reqFeedback" translation="[88, 64]" width="1600" color="0xEDEDEDAD" visible="false">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="27" />
      </Label>
      <RowList id="reqRow" translation="[68, 32]" itemComponentName="MediaCardItem"
               drawFocusFeedback="false" rowFocusAnimationStyle="fixedFocus"
               itemSize="[1852, 412]" numRows="1" focusXOffset="[20]" rowItemSize="[[176, 412]]" rowItemSpacing="[[40, 0]]"
               showRowLabel="[false]" visible="false" />
    </Group>
    <LoadingSpinner id="spinner" translation="[924, 600]" visible="false" />
    <Group id="status" visible="false">
      <Label id="statusTitle" width="1920" horizAlign="center" color="0xEDEDEDFF" translation="[0, 560]">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="41" />
      </Label>
      <Label id="statusBody" width="1920" horizAlign="center" color="0xEDEDED9E" translation="[0, 622]">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="27" />
      </Label>
      <PillButton id="retryBtn" text="Try again" height="64" fontSize="24" translation="[0, 690]" visible="false" />
    </Group>
    <Timer id="debounce" duration="0.4" repeat="false" />
  </children>
</component>
