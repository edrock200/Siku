<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (and a library's "Recommended" landing): the Skyline feed fed by /api/v2/home/sections
  or /api/v2/library/{id}/sections. params: { libraryId?, libraryName?, mode?, mediaType? }
  Every non-featured row shows at most 20 cards and ends with an "Explore all" card that opens the
  row's full page (LibraryScreen, section "section"; SectionRows.brs).
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="HomePage" extends="ShellPage">
  <script type="text/brightscript" uri="pkg:/components/screens/home/HomePage.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HomeCardActions.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/HomeCache.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/SectionRows.brs" />
  <children>
    <HomeSkylineFeed id="feed" />
    <ShellActionMenu id="menu" />
  </children>
</component>
