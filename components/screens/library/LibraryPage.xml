<?xml version="1.0" encoding="utf-8"?>
<!--
  6-column poster grid (design-spec §4.2) for a library's Browse / Collections, and the personal
  lists (Favorites, Watchlist, Watch History), a person's filmography or a section's "See all".
  params:
    section     "browse" | "collections" | "collection" | "favorites" | "watchlist" | "history" | "person" | "section"
    libraryId, libraryName, mode   the library (browse / collections / collection)
    mediaType   "movie" | "series" forced type (Movies / Series tab on a mixed library)
    collectionId, collectionTitle  (section "collection")
    personId, personName           (section "person")
    sectionId, scope               (section "section")
    title       page title override
    hostedInShell  true when the shell's top bar is above the page (default layout)
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="LibraryPage" extends="ShellPage">
  <script type="text/brightscript" uri="pkg:/components/screens/library/LibraryPage.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HomeCardActions.brs" />
  <children>
    <Label id="titleLabel" translation="[80, 128]" color="0xEDEDEDFF" maxLines="1" width="1400">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="38" />
    </Label>
    <Label id="countLabel" translation="[80, 176]" color="0xEDEDED9E" maxLines="1" width="1400" visible="false">
      <Font role="font" uri="pkg:/fonts/Inter-medium.otf" size="24" />
    </Label>
    <Group id="controls" translation="[80, 196]" visible="false">
      <PillButton id="sortPill" text="Sort · Title" height="56" fontSize="24" padX="28" scaleOnFocus="1.04" />
      <PillButton id="filterPill" text="Filter" height="56" fontSize="24" padX="28" scaleOnFocus="1.04" />
      <PillButton id="clearPill" text="Clear filters" height="56" fontSize="24" padX="28" scaleOnFocus="1.04" visible="false" />
      <PillButton id="shufflePill" text="Shuffle" iconUri="pkg:/images/icons/shuffle.png" height="56" fontSize="24" padX="28" scaleOnFocus="1.04" />
    </Group>
    <MarkupGrid id="grid" translation="[70, 284]" itemComponentName="MediaCardItem" numColumns="6" numRows="2"
                itemSize="[269, 493]" itemSpacing="[40, 60]" drawFocusFeedback="false"
                vertFocusAnimationStyle="floatingFocus" visible="false" />
    <LoadingSpinner id="spinner" translation="[924, 560]" visible="false" />
    <Group id="status" visible="false">
      <Label id="statusTitle" width="1920" horizAlign="center" color="0xEDEDEDFF" translation="[0, 470]">
        <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="41" />
      </Label>
      <Label id="statusBody" width="1920" horizAlign="center" color="0xEDEDED9E" translation="[0, 532]">
        <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="27" />
      </Label>
      <PillButton id="retryBtn" text="Retry" height="64" fontSize="24" translation="[0, 600]" visible="false" />
    </Group>
    <ShellPanel id="sortPanel" visible="false" />
    <ShellPanel id="filterPanel" visible="false" />
    <ShellPanel id="filterFly" width="320" visible="false" />
    <ShellActionMenu id="menu" />
  </children>
</component>
