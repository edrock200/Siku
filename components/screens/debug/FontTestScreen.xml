<?xml version="1.0" encoding="utf-8"?>
<!-- Developer diagnostic for Label/9-patch rendering on real Rokus. Open with
     POST http://<roku-ip>:8060/launch/dev?debugScreen=FontTestScreen
     SPDX-License-Identifier: AGPL-3.0-or-later -->
<component name="FontTestScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/screens/debug/FontTestScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Label id="hdr" translation="[100, 20]" width="1700" color="0xEDEDEDFF">
      <Font role="font" uri="pkg:/fonts/Inter-semibold.otf" size="26" />
    </Label>
    <Label id="report" translation="[100, 700]" width="1700" wrap="true" color="0xEDEDED9E">
      <Font role="font" uri="pkg:/fonts/Inter-regular.otf" size="24" />
    </Label>
  </children>
</component>
