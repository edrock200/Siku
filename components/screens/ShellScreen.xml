<?xml version="1.0" encoding="utf-8"?>
<!--
  Root shell (design-spec §3): top bar with tabs, cascade / For You / profile dropdown panels,
  and a content area that hosts the root pages (HomePage, LibraryPage, ForYouPage, CalendarPage,
  RequestsPage). The Requests tab appears only when GET /api/v2/requests/status enables it.
  SPDX-License-Identifier: AGPL-3.0-or-later
-->
<component name="ShellScreen" extends="BaseScreen">
  <interface>
    <!-- Set by Settings_notify when a Settings_load this screen started lands (Settings.brs). -->
    <field id="settingsLoaded" type="boolean" alwaysNotify="true" onChange="onSettingsChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/ShellScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Requests.brs" />
  <children>
    <Group id="content" />
    <ShellTopBar id="bar" />
    <ShellPanel id="panelMain" visible="false" />
    <ShellPanel id="panelFly" width="300" visible="false" />
  </children>
</component>
