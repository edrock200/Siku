<?xml version="1.0" encoding="utf-8"?>
<!-- Root scene: owns the screen stack and app-wide state on m.global.
     SPDX-License-Identifier: AGPL-3.0-or-later -->
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" onChange="onLaunchArgs" />
    <field id="inputArgs" type="assocarray" onChange="onInputArgs" />
    <field id="exitApp" type="boolean" value="false" />
    <!-- From source/main.brs: memory warning level (percent of the channel's limit, alwaysNotify)
         and app focus (false while a system overlay or the screensaver covers Siku). -->
    <field id="memoryPressure" type="integer" alwaysNotify="true" onChange="onMemoryPressure" />
    <field id="appFocused" type="boolean" value="true" onChange="onAppFocused" />
    <!-- From source/main.brs at launch: { low, reasons, foregroundMb } (MainEvents_deviceTier). -->
    <field id="deviceTier" type="assocarray" onChange="onDeviceTier" />
    <!-- From source/main.brs: a Roku voice transport event; returns { status } for EventResponse. -->
    <function name="handleTransport" />
    <!-- From PlayerScreen: a playback stop to deliver, retried after a failure (PlaybackJobs.brs). -->
    <function name="playbackStop" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Session.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Accounts.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/HomeCache.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/ProfileLaunch.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/A11y.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/VoiceTransport.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/DeepLink.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Api.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/PlaybackJobs.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/MemoryPolicy.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Diag.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/DiagScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
    <Group id="screens" />
    <Toast id="toast" />
    <LoadingSpinner id="globalSpinner" visible="false" />
  </children>
</component>
